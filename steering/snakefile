# Snakemake workflow for the AIM-Resolve iterative reconstruction pipeline.
#
# This pipeline performs iterative sky model reconstruction consisting of:
#   0. Initialize the configuration and run a first background-only reconstruction.
#   1..n For each subsequent iteration:
#       a) Detect point sources and extended objects in the current reconstruction.
#       b) Build an enhanced sky model incorporating the detected components.
#       c) Pre-fit: transition samples from the old to the new model domain.
#       d) Reconstruct: optimize the enhanced sky model via variational inference.
#
# Usage:
#   snakemake --configfile config/snake.yml
#   snakemake --config file=config/snake.yml cuda_device=0
#
# Configuration keys (loaded from the YAML file specified by ``file``):
#   odir   : str  - Output directory for all pipeline artifacts.
#   n_it   : int  - Total number of reconstruction iterations.
#   data   : dict - Data section containing at least ``fname`` (path to the data file).

import os

cuda_device = config.get('cuda_device', '')

if str(cuda_device) == '':
    os.environ['JAX_PLATFORM_NAME'] = 'cpu'
else:
    os.environ['CUDA_VISIBLE_DEVICES'] = str(cuda_device)
    os.environ['XLA_PYTHON_CLIENT_PREALLOCATE'] = 'false'


from aim_resolve import yaml_load

file = config.get('file', 'config/snake.yml')
dct = yaml_load(file)

odir = dct['odir']
n_it = dct['n_it']
data = dct['data']['fname']

base = f'{odir}/files/base.yml'



# --- Target rule ---
# Requests the final reconstruction file, triggering the full pipeline.
rule all:
    input:
        f'{odir}/files/{n_it-1}_rec.pkl'



# --- Iteration 0: Initialization ---
# Generate the initial configuration file from the base model YAML and pipeline settings.
rule:
    name:
        '0. model'
    input:
        m = 'config/0_mdl.yml',
    output:
        f'{odir}/files/0_pre.yml',
    params:
        s = file
    shell:
        'python3 scripts/initialize.py {input.m} config/base.yml {params.s}'



# --- Iteration 0: Background reconstruction ---
# Optimize the initial background-only sky model to obtain a first reconstruction.
rule:
    name:
        f'0. reconstruct'
    input:
        p = f'{odir}/files/0_pre.yml',
        d = data,
    output:
        f'{odir}/files/0_rec.pkl',
    params:
        t = {},
        b = base,
        i = 0,
    shell:
        'python3 scripts/reconstruct.py {input.p} {params.t} {params.b} {params.i}'



# --- Iterations 1..n_it-1: Iterative source detection and reconstruction ---
for it in range(1, n_it):

    # Step a) Detect point sources and extended objects in the previous reconstruction.
    rule:
        name:
            f'{it}. detect'
        input:
            o = f'{odir}/files/{it-1}_rec.pkl',
        output:
            f'{odir}/files/{it}_det.npz',
        params:
            b = base,
            i = it,
        shell:
            'python3 scripts/detect.py {input.o} {params.b} {params.i}'


    # Step b) Build an enhanced sky model with detected point sources and objects.
    rule:
        name:
            f'{it}. model'
        input:
            p = f'{odir}/files/{it-1}_pre.yml',
            o = f'{odir}/files/{it-1}_rec.pkl',
            d = f'{odir}/files/{it}_det.npz',
        output:
            f'{odir}/files/{it}_mdl.yml',
        params:
            b = base,
            i = it,
        shell:
            'python3 scripts/model.py {input.p} {input.o} {input.d} {params.b} {params.i}'


    # Step c) Transition samples from the old to the new sky model domain.
    rule:
        name:
            f'{it}. pre-fit'
        input:
            m = f'{odir}/files/{it}_mdl.yml',
        output:
            f'{odir}/files/{it}_pre.yml',
        params:
            r = f'{odir}/opt/{it-1}_rec/last.pkl',
            b = base,
            i = it,
        shell:
            'python3 scripts/pre_fit.py {input.m} {params.r} {params.b} {params.i}'


    # Step d) Optimize the enhanced sky model via variational inference.
    rule:
        name:
            f'{it}. reconstruct'
        input:
            m = f'{odir}/files/{it}_pre.yml',
            d = data,
        output:
            f'{odir}/files/{it}_rec.pkl',
        params:
            t = f'{odir}/opt/{it}_pre/last.pkl',
            b = base,
            i = it,
        shell:
            'python3 scripts/reconstruct.py {input.m} {params.t} {params.b} {params.i}'
